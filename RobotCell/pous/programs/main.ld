PROGRAM main
  VAR
    ESTOP_OK : BOOL AT %IX0.0; (* TRUE = E-stop NOT pressed (NC) *)
    DOOR_CLOSED : BOOL AT %IX0.1; (* TRUE = guard door closed *)
    PB_START : BOOL AT %IX0.2; (* Local Panel START *)
    PB_STOP : BOOL AT %IX0.3; (* Local Panel STOP *)
    PB_RESET : BOOL AT %IX0.4; (* Local Panel RESET *)
    SEL_REMOTE : BOOL AT %IX0.5; (* Key switch: TRUE = REMOTE (SCADA) *)
    PRODUCT_AT_PICK : BOOL AT %IX0.6; (* Product waiting to pick stop *)
    CAMERA_DONE : BOOL AT %IX0.7; (* Camera check finished *)
    CAMERA_PASS : BOOL AT %IX1.0; (* Camera: Product is good *)
    ROBOT_READY : BOOL AT %IX1.1; (* Robot can take a move *)
    ROBOT_BUSY : BOOL AT %IX1.2; (* Robot is moving *)
    ROBOT_DONE : BOOL AT %IX1.3; (* Robot reached the target *)
    ROBOT_AT_HOME : BOOL AT %IX1.4; (* Robot is at original position *)
    ROBOT_FAULT : BOOL AT %IX1.5; (* Robot has a fault *)
    VACUUM_OK : BOOL AT %IX1.6; (* Gripper holds a product *)
    CARTON_AT_PACK : BOOL AT %IX1.7; (* Carton in place at pack station *)
    CARTON_OUT : BOOL AT %IX2.0; (* Pulse: full carton left *)
    ROBOT_POS : INT AT %IW0; (* Robot position number ( 99 = moving ) *)
    ROBOT_ANGLE : INT AT %IW1; (* Arm angle in degrees *)
    ROBOT_REACH : INT AT %IW2; (* Arm reach in mm *)
    CAMERA_CODE : INT AT %IW3; (* 0 good, 1 dent, 2 no label, 3 colour, 9 none *)
    INFEED_RUN : BOOL AT %QX0.0; (* Infeed conveyor motor *)
    OUTFEED_RUN : BOOL AT %QX0.1; (* Carton conveyor motor *)
    CAMERA_TRIGGER : BOOL AT %QX0.2; (* Start a camera check *)
    ROBOT_ENABLE : BOOL AT %QX0.3; (* Allow the robot to move *)
    ROBOT_GO : BOOL AT %QX0.4; (* Robot: Start move to ROBOT_TARGET *)
    ROBOT_RESET : BOOL AT %QX0.5; (* Robot: Clear Fault *)
    VACUUM_ON : BOOL AT %QX0.6; (* Gripper Vacuum *)
    LAMP_GREEN : BOOL AT %QX0.7; (* Stack light green *)
    LAMP_AMBER : BOOL AT %QX1.0; (* Stack light amber *)
    LAMP_RED : BOOL AT %QX1.1; (* Stack light red *)
    BUZZER : BOOL AT %QX1.2; (* Alarm buzzer *)
    ROBOT_TARGET : INT AT %QW0; (* Position: 0 home, 1 pick, 11 - 19 slot, 20 reject *)
    ROBOT_SPEED : INT AT %QW1; (* Robot speed 10 - 100% *)
    PATTERN : INT AT %QW2; (* Products per carton *)
    MACHINE_ON : BOOL; (* Cell switch on *)
    SEQ_STEP : INT AT %MW11; (* Sequence step number *)
    S0 : BOOL; (* Step 0: idle *)
    S10 : BOOL; (* Step 10: infeed *)
    S20 : BOOL; (* Step 20: Camera *)
    S30 : BOOL; (* Step 30: Robot Pick *)
    S40 : BOOL; (* Step 40: Grip *)
    S50 : BOOL; (* Step 50: Robot to place *)
    S60 : BOOL; (* Step 60: Release and count *)
    S70 : BOOL; (* Step 70: Carton full *)
    S80 : BOOL; (* Step 80: Carton out *)
    S90 : BOOL; (* Step 90: Carton In *)
    PASS_MEM : BOOL; (* Camera Result remebered *)
    SLOT : INT AT %MW12; (* Products in current carton *)
    SLOT0 : INT AT %MW13;
    PLACE_POS : INT; (* Slot target for the robot *)
    CARTON_FULL : BOOL; (* SLOT reached PATTERN *)
    RELEASE_DONE : BOOL; (* Release time over *)
    TON1 : TON;
    HMI_START : BOOL AT %MX0.0; (* HMI button START from CODESYS *)
    HMI_STOP : BOOL AT %MX0.1; (* HMI button STOP *)
    HMI_RESET : BOOL AT %MX0.2; (* HMI button RESET *)
    HMI_HEARTBEAT : BOOL AT %MX1.0; (* Toggle every 1s while the HMI runs *)
    HB_HIGH : BOOL; (* Heartbeat stuck high for 3s *)
    HB_LOW : BOOL; (* Heartbeat stuck low for 3s *)
    HMI_OK : BOOL; (* HMI is alive *)
    START_CMD : BOOL; (* Start from the active panel *)
    STOP_CMD : BOOL; (* Stop from any panel *)
    RESET_CMD : BOOL; (* Reset from the active panel *)
    TON2 : TON;
    TON3 : TON;
  END_VAR

